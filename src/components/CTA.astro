<section
  class="relative h-auto bg-gray-900 text-white flex items-center justify-center overflow-hidden p-6 pt-10"
>
  <!-- Cohete por detrás en el centro tirando a la izquierda -->
  <div
    class="absolute inset-0 flex items-center justify-center z-0 pointer-events-none"
  >
    <div class="transform -translate-x-10 opacity-20">
      <svg width="280" height="280" class="fill-current text-violet-500/30">
        <use href="/Impresiones-3D/sprite.svg#cohete"></use>
      </svg>
    </div>
  </div>

  <!-- Contenido por delante en columna (Texto arriba, Botón abajo) -->
  <div class="relative z-10 flex flex-col gap-8 w-full text-center">
    <!-- Bloque de Texto -->
    <div>
      <h1 class="text-3xl font-black mb-3">¿Tenés una idea?</h1>
      <p class="text-base text-gray-300 leading-relaxed">
        Contame qué necesitás y te paso un presupuesto sin compromiso.
      </p>
    </div>

    <!-- Bloque del Botón -->
    <div class="w-full mb-4">
      <button
        class="w-full rounded-xl bg-violet-600 active:scale-95 py-4 text-base font-bold text-white shadow-lg shadow-violet-600/30 transition-all duration-200"
      >
        Solicitar presupuesto
      </button>
    </div>
  </div>
</section>
